# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://tasavzla:secret@localhost:5432/tasavzla

# How many times to retry BCV scraping before falling back
BCV_RETRIES=3

# Timeout in seconds for each BCV HTTP request
BCV_TIMEOUT=15

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
